#
# Check internal and external links in every Markdown file with lychee,
# using lychee.toml. Needs lychee on PATH: https://lychee.cli.rs/

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec lychee --config lychee.toml "$@" -- README.md CONTRIBUTING.md agent-instructions.md briefs/
