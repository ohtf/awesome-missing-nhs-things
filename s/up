#
# Preview the Markdown files roughly as GitHub renders them. Serves the repo on
# 127.0.0.1 at a free port (or $PORT), opens a browser, and reloads the page
# when a Markdown file changes. Rendering happens in the browser with marked
# and github-markdown-css from jsDelivr, so it needs Python 3 and a network
# connection, and nothing else. Pass --no-open to skip opening the browser.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec python3 -I - "$PWD" "$@" <<'PY'
import html
import http.server
import os
import pathlib
import sys
import threading
import urllib.parse
import webbrowser

ROOT = pathlib.Path(sys.argv[1]).resolve()
OPEN_BROWSER = "--no-open" not in sys.argv[2:]
PORT = int(os.environ.get("PORT", "0"))

SHELL = """<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} - preview</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.9.0/github-markdown.css" integrity="sha384-X2shx+NJpjDz2Pj4RRV7UUJWOF5zvFlJ8H8hzDTDEK8HIYY31T157AgGG6Kjq4w0" crossorigin="anonymous">
<style>
  body {{ margin: 0; background: #f6f8fa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif; }}
  .bar {{ background: #24292f; color: #fff; padding: 12px 24px; font-size: 14px; }}
  .bar a {{ color: #fff; text-decoration: none; font-weight: 600; }}
  .bar span {{ opacity: .7; }}
  main {{ max-width: 1012px; margin: 24px auto; padding: 0 16px; }}
  .file {{ border: 1px solid #d0d7de; border-radius: 6px; background: #fff; }}
  .file-head {{ border-bottom: 1px solid #d0d7de; padding: 8px 16px; font-size: 14px; font-weight: 600; background: #f6f8fa; border-radius: 6px 6px 0 0; }}
  .markdown-body {{ padding: 32px; }}
  @media (prefers-color-scheme: dark) {{
    body {{ background: #010409; }}
    .bar {{ background: #161b22; }}
    .file {{ border-color: #30363d; background: #0d1117; }}
    .file-head {{ border-color: #30363d; background: #161b22; color: #e6edf3; }}
  }}
  @media (max-width: 767px) {{ .markdown-body {{ padding: 16px; }} }}
</style>
</head>
<body>
<div class="bar"><a href="/">{repo}</a> <span>/ {title}</span></div>
<main><div class="file"><div class="file-head">{title}</div><article class="markdown-body" id="content">Loading...</article></div></main>
<script src="https://cdn.jsdelivr.net/npm/marked@18.2.0/lib/marked.umd.js" integrity="sha384-DDYDxilZ1LlqPSbaRHlrwh12h+3fUewuQj7HjscrZIWt5bGyQ+n0DHtIoZE3i3zU" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/marked-gfm-heading-id@4.1.4/lib/index.umd.js" integrity="sha384-AfBBApo8mdLz/88akCqlD8FBp9ckhcuqWvfy2E32yJ/5u9z858eGxW7sLxvEdOgR" crossorigin="anonymous"></script>
<script>
  marked.use({{ gfm: true }}, markedGfmHeadingId.gfmHeadingId());
  const source = {source};
  async function render() {{
    const response = await fetch(source + "?raw=1", {{ cache: "no-store" }});
    document.getElementById("content").innerHTML = marked.parse(await response.text());
    if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  }}
  render();
  let seen = null;
  setInterval(async () => {{
    try {{
      const stamp = await (await fetch("/__mtime", {{ cache: "no-store" }})).text();
      if (seen !== null && stamp !== seen) render();
      seen = stamp;
    }} catch (e) {{}}
  }}, 1000);
</script>
</body>
</html>
"""


def markdown_mtime():
    stamps = (p.stat().st_mtime_ns for p in ROOT.rglob("*.md") if ".git" not in p.parts)
    return str(max(stamps, default=0))


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def log_message(self, format, *args):
        pass

    def send_text(self, body, content_type):
        data = body.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        if url.path == "/__mtime":
            return self.send_text(markdown_mtime(), "text/plain; charset=utf-8")

        target = (ROOT / urllib.parse.unquote(url.path).lstrip("/")).resolve()
        if ROOT not in (target, *target.parents) or ".git" in target.relative_to(ROOT).parts:
            return self.send_error(404)

        if target.is_dir():
            if not url.path.endswith("/"):
                self.send_response(301)
                self.send_header("Location", url.path + "/")
                self.end_headers()
                return
            if (target / "README.md").is_file():
                target = target / "README.md"
            else:
                return self.send_listing(target)

        if target.suffix == ".md" and target.is_file():
            if url.query == "raw=1":
                return self.send_text(target.read_text(encoding="utf-8"), "text/markdown; charset=utf-8")
            rel = target.relative_to(ROOT).as_posix()
            page = SHELL.format(
                title=html.escape(rel),
                repo=html.escape(ROOT.name),
                source=repr("/" + urllib.parse.quote(rel)),
            )
            return self.send_text(page, "text/html; charset=utf-8")

        if target.is_file() and not target.suffix:
            return self.send_text(target.read_text(encoding="utf-8"), "text/plain; charset=utf-8")

        return super().do_GET()

    def send_listing(self, directory):
        rel = directory.relative_to(ROOT).as_posix()
        items = sorted(p for p in directory.iterdir() if not p.name.startswith("."))
        lines = [f"# {rel}/", ""]
        lines += [f"- [{p.name}{'/' if p.is_dir() else ''}]({urllib.parse.quote(p.name)}{'/' if p.is_dir() else ''})" for p in items]
        page = SHELL.format(
            title=html.escape(rel + "/"),
            repo=html.escape(ROOT.name),
            source=repr("data:text/plain;charset=utf-8," + urllib.parse.quote("\n".join(lines))),
        )
        return self.send_text(page.replace('source + "?raw=1"', "source"), "text/html; charset=utf-8")


server = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
url = f"http://127.0.0.1:{server.server_address[1]}/"
print(f"Previewing {ROOT.name} at {url} (Ctrl-C to stop)", file=sys.stderr)
if OPEN_BROWSER:
    threading.Timer(0.3, webbrowser.open, args=(url,)).start()
try:
    server.serve_forever()
except KeyboardInterrupt:
    print(file=sys.stderr)
PY
